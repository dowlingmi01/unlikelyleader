# Copy to .env.local and fill in values for local/production.

# Canonical site URL (must match your Search Console property)
NEXT_PUBLIC_SITE_URL=https://www.theunlikelyleader.com

# Supabase (required for forms)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics — use Plausible (recommended) and/or GA4
# Plausible: your site domain as registered in Plausible (no https://)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=theunlikelyleader.com
# GA4: optional measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=
